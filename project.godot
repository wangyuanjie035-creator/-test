; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="+test"
run/main_scene="res://scenes/topic_pool/dynamic_topic_entry.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameExecutor="*res://scripts/dev/dev_game_executor_bridge.gd"
VisionRun="*res://scripts/run/vision_run_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="+test"

[editor_plugins]

enabled=PackedStringArray("res://addons/hasturoperationgd/plugin.cfg")
