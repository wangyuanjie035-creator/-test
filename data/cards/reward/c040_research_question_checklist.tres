[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/card_definition.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_draw_if_inspiration"]
script = ExtResource("2_effect")
effect_type = &"draw"
amount = 1
target = &"self"
condition = &"has_inspiration"

[sub_resource type="Resource" id="Effect_gain_inspiration"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"inspiration"
target = &"self"

[sub_resource type="Resource" id="Effect_methodology"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"methodology_notes"
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_draw_if_inspiration"]
script = ExtResource("2_effect")
effect_type = &"draw"
amount = 2
target = &"self"
condition = &"has_inspiration"

[sub_resource type="Resource" id="Effect_upgraded_gain_inspiration"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"inspiration"
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_methodology"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"methodology_notes"
target = &"self"

[resource]
script = ExtResource("1_card")
id = &"C040"
display_name = "研究问题清单"
card_type = &"skill"
rarity = &"common"
cost = 1
tags = PackedStringArray("literature", "inspiration", "methodology")
description = "若有灵感，抽 1 张牌；获得 1 灵感和 1 方法论笔记。"
upgraded_description = "若有灵感，抽 2 张牌；获得 1 灵感和 1 方法论笔记。"
effects = Array[Resource]([SubResource("Effect_draw_if_inspiration"), SubResource("Effect_gain_inspiration"), SubResource("Effect_methodology")])
upgraded_effects = Array[Resource]([SubResource("Effect_upgraded_draw_if_inspiration"), SubResource("Effect_upgraded_gain_inspiration"), SubResource("Effect_upgraded_methodology")])
