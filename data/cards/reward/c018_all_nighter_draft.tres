[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/card_definition.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_lose_energy"]
script = ExtResource("2_effect")
effect_type = &"lose_energy"
amount = 4
target = &"self"

[sub_resource type="Resource" id="Effect_gain_draft"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 2
resource = &"draft"
target = &"self"

[sub_resource type="Resource" id="Effect_progress"]
script = ExtResource("2_effect")
effect_type = &"gain_progress"
amount = 8
target = &"self"

[sub_resource type="Resource" id="Effect_add_dazed"]
script = ExtResource("2_effect")
effect_type = &"add_card_to_deck"
target = &"self"
card_id = &"S005"

[sub_resource type="Resource" id="Effect_upgraded_lose_energy"]
script = ExtResource("2_effect")
effect_type = &"lose_energy"
amount = 3
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_gain_draft"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 2
resource = &"draft"
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_progress"]
script = ExtResource("2_effect")
effect_type = &"gain_progress"
amount = 10
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_add_dazed"]
script = ExtResource("2_effect")
effect_type = &"add_card_to_deck"
target = &"self"
card_id = &"S005"

[resource]
script = ExtResource("1_card")
id = &"C018"
display_name = "通宵赶稿"
card_type = &"action"
rarity = &"common"
cost = 0
tags = PackedStringArray("rush", "risk", "draft")
description = "失去 4 精力，获得 2 草稿和 8 进度；将 1 张恍惚加入牌组。"
upgraded_description = "失去 3 精力，获得 2 草稿和 10 进度；将 1 张恍惚加入牌组。"
effects = Array[Resource]([SubResource("Effect_lose_energy"), SubResource("Effect_gain_draft"), SubResource("Effect_progress"), SubResource("Effect_add_dazed")])
upgraded_effects = Array[Resource]([SubResource("Effect_upgraded_lose_energy"), SubResource("Effect_upgraded_gain_draft"), SubResource("Effect_upgraded_progress"), SubResource("Effect_upgraded_add_dazed")])
