amount = 12
target = &"self"

[resource]
script = ExtResource("1_card")
id = &"C019"
display_name = "极限 ddl"
card_type = &"skill"
rarity = &"common"
cost = 0
tags = PackedStringArray("rush", "risk")
description = "失去 3 精力；下一次获得进度时额外 +10，本牌消耗。"
upgraded_description = "失去 2 精力；下一次获得进度时额外 +12，本牌消耗。"
effects = Array[Resource]([SubResource("Effect_lose_energy"), SubResource("Effect_next_progress")])
