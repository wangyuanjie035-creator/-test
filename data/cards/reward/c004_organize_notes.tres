[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/card_definition.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_gain_draft"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"draft"
target = &"self"

[sub_resource type="Resource" id="Effect_draw"]
script = ExtResource("2_effect")
effect_type = &"draw"
amount = 1
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_gain_draft"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 2
resource = &"draft"
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_draw"]
script = ExtResource("2_effect")
effect_type = &"draw"
amount = 1
target = &"self"

[resource]
script = ExtResource("1_card")
id = &"C004"
display_name = "整理笔记"
card_type = &"skill"
rarity = &"common"
cost = 1
tags = PackedStringArray("literature", "draft")
description = "获得 1 草稿，抽 1 张牌。"
upgraded_description = "获得 2 草稿，抽 1 张牌。"
effects = Array[Resource]([SubResource("Effect_gain_draft"), SubResource("Effect_draw")])
upgraded_effects = Array[Resource]([SubResource("Effect_upgraded_gain_draft"), SubResource("Effect_upgraded_draw")])
