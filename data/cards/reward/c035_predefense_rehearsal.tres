[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/card_definition.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_progress"]
script = ExtResource("2_effect")
effect_type = &"gain_progress"
amount = 8
target = &"self"

[sub_resource type="Resource" id="Effect_reputation"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"reputation"
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_progress"]
script = ExtResource("2_effect")
effect_type = &"gain_progress"
amount = 11
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_reputation"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"reputation"
target = &"self"

[resource]
script = ExtResource("1_card")
id = &"C035"
display_name = "预答辩演练"
card_type = &"action"
rarity = &"doctoral"
cost = 2
tags = PackedStringArray("doctor", "paper", "reputation")
description = "获得 8 进度和 1 声望。"
upgraded_description = "获得 11 进度和 1 声望。"
effects = Array[Resource]([SubResource("Effect_progress"), SubResource("Effect_reputation")])
upgraded_effects = Array[Resource]([SubResource("Effect_upgraded_progress"), SubResource("Effect_upgraded_reputation")])
