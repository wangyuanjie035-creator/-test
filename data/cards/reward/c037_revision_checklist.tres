[gd_resource type="Resource" script_class="CardDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/card_definition.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_remove_delay"]
script = ExtResource("2_effect")
effect_type = &"remove_status"
amount = 1
target = &"hand"
card_id = &"S001"

[sub_resource type="Resource" id="Effect_progress"]
script = ExtResource("2_effect")
effect_type = &"gain_progress"
amount = 4
target = &"self"

[sub_resource type="Resource" id="Effect_draft"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"draft"
target = &"self"

[sub_resource type="Resource" id="Effect_methodology"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"methodology_notes"
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_remove_delay"]
script = ExtResource("2_effect")
effect_type = &"remove_status"
amount = 1
target = &"hand"
card_id = &"S001"

[sub_resource type="Resource" id="Effect_upgraded_progress"]
script = ExtResource("2_effect")
effect_type = &"gain_progress"
amount = 6
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_draft"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 2
resource = &"draft"
target = &"self"

[sub_resource type="Resource" id="Effect_upgraded_methodology"]
script = ExtResource("2_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"methodology_notes"
target = &"self"

[resource]
script = ExtResource("1_card")
id = &"C037"
display_name = "返修清单"
card_type = &"skill"
rarity = &"common"
cost = 1
tags = PackedStringArray("revision", "paper", "delay", "methodology")
description = "移除手牌中 1 张拖延；获得 4 进度、1 草稿和 1 方法论笔记。"
upgraded_description = "移除手牌中 1 张拖延；获得 6 进度、2 草稿和 1 方法论笔记。"
effects = Array[Resource]([SubResource("Effect_remove_delay"), SubResource("Effect_progress"), SubResource("Effect_draft"), SubResource("Effect_methodology")])
upgraded_effects = Array[Resource]([SubResource("Effect_upgraded_remove_delay"), SubResource("Effect_upgraded_progress"), SubResource("Effect_upgraded_draft"), SubResource("Effect_upgraded_methodology")])
