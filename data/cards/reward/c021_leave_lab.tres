amount = 4
resource = &"energy"
target = &"self"

[resource]
script = ExtResource("1_card")
id = &"C021"
display_name = "走出实验楼"
card_type = &"skill"
rarity = &"common"
cost = 0
tags = PackedStringArray("care", "resilience")
description = "抽 1 张牌，恢复 2 精力，本牌消耗。"
upgraded_description = "抽 1 张牌，恢复 4 精力，本牌消耗。"
effects = Array[Resource]([SubResource("Effect_draw"), SubResource("Effect_heal")])
