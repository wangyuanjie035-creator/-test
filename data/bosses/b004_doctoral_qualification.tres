[gd_resource type="Resource" script_class="BossDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/boss_definition.gd" id="1_boss"]
[ext_resource type="Script" path="res://scripts/data/boss_intent_definition.gd" id="2_intent"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="3_effect"]

[sub_resource type="Resource" id="Effect_add_anxiety"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S002"

[sub_resource type="Resource" id="Effect_add_self_doubt"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S010"

[sub_resource type="Resource" id="Effect_add_info_overload"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S004"

[sub_resource type="Resource" id="Effect_add_delay"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S001"

[sub_resource type="Resource" id="Effect_scope_raise_target"]
script = ExtResource("3_effect")
effect_type = &"modify_target_progress"
amount = 4
target = &"self"

[sub_resource type="Resource" id="Intent_scope_expansion"]
script = ExtResource("2_intent")
id = &"scope_expansion"
display_name = "课题规模放大"
intent_type = &"interference"
pressure = 6
effects = Array[Resource]([SubResource("Effect_scope_raise_target")])

[sub_resource type="Resource" id="Effect_spend_methodology"]
script = ExtResource("3_effect")
effect_type = &"gain_resource"
amount = -1
resource = &"methodology_notes"
target = &"self"

[sub_resource type="Resource" id="Effect_theory_progress"]
script = ExtResource("3_effect")
effect_type = &"gain_progress"
amount = 18
target = &"self"

[sub_resource type="Resource" id="Intent_theory_foundation"]
script = ExtResource("2_intent")
id = &"theory_foundation"
display_name = "理论基础审查"
intent_type = &"check"
pressure = 0
condition = &"has_3_methodology_notes"
success_effects = Array[Resource]([SubResource("Effect_spend_methodology"), SubResource("Effect_theory_progress")])
failure_effects = Array[Resource]([SubResource("Effect_add_info_overload")])

[sub_resource type="Resource" id="Intent_qualification_questions"]
script = ExtResource("2_intent")
id = &"qualification_questions"
display_name = "资格考试追问"
intent_type = &"pressure"
pressure = 13
condition = &"has_2_inspiration"
failure_effects = Array[Resource]([SubResource("Effect_add_self_doubt")])

[sub_resource type="Resource" id="Intent_committee_compare"]
script = ExtResource("2_intent")
id = &"committee_compare"
display_name = "同届横向比较"
intent_type = &"interference"
pressure = 8
effects = Array[Resource]([SubResource("Effect_add_anxiety")])

[sub_resource type="Resource" id="Effect_gain_reputation"]
script = ExtResource("3_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"reputation"
target = &"self"

[sub_resource type="Resource" id="Effect_pipeline_progress"]
script = ExtResource("3_effect")
effect_type = &"gain_progress"
amount = 12
target = &"self"

[sub_resource type="Resource" id="Intent_paper_pipeline"]
script = ExtResource("2_intent")
id = &"paper_pipeline"
display_name = "论文管线追问"
intent_type = &"check"
pressure = 0
condition = &"has_2_paper_fragments"
success_effects = Array[Resource]([SubResource("Effect_gain_reputation"), SubResource("Effect_pipeline_progress")])
failure_effects = Array[Resource]([SubResource("Effect_add_delay")])

[sub_resource type="Resource" id="Effect_phase_progress"]
script = ExtResource("3_effect")
effect_type = &"gain_progress"
amount = 14
target = &"self"

[sub_resource type="Resource" id="Effect_phase_raise_target"]
script = ExtResource("3_effect")
effect_type = &"modify_target_progress"
amount = 10
target = &"self"

[resource]
script = ExtResource("1_boss")
id = &"B004"
display_name = "博士资格考核"
stage = &"doctor_1"
target_progress = 135
starting_status_cards = PackedStringArray("S002", "S010")
passive_rules = PackedStringArray("开局将 1 张焦虑和 1 张自我怀疑加入弃牌堆。", "进度达到 75 时进行一次资格审查检查。", "博士线首个 Boss，重点检查方法论积累和论文管线。")
intents = Array[Resource]([SubResource("Intent_scope_expansion"), SubResource("Intent_theory_foundation"), SubResource("Intent_qualification_questions"), SubResource("Intent_committee_compare"), SubResource("Intent_paper_pipeline")])
phase_trigger_progress = 75
phase_condition = &"has_3_methodology_notes_or_2_paper_fragments"
phase_success_effects = Array[Resource]([SubResource("Effect_phase_progress")])
phase_failure_effects = Array[Resource]([SubResource("Effect_add_anxiety"), SubResource("Effect_add_self_doubt"), SubResource("Effect_phase_raise_target")])
phase_event_id = &"doctoral_qualification_review"
victory_rewards = PackedStringArray("methodology_notes", "paper_fragments")
failure_result = &"qualification_failed"
