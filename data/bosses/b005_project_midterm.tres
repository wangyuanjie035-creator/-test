[gd_resource type="Resource" script_class="BossDefinition" format=3]

[ext_resource type="Script" path="res://scripts/data/boss_definition.gd" id="1_boss"]
[ext_resource type="Script" path="res://scripts/data/boss_intent_definition.gd" id="2_intent"]
[ext_resource type="Script" path="res://scripts/data/effect_definition.gd" id="3_effect"]

[sub_resource type="Resource" id="Effect_add_dazed"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S005"

[sub_resource type="Resource" id="Effect_add_delay"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S001"

[sub_resource type="Resource" id="Effect_add_info_overload"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S004"

[sub_resource type="Resource" id="Effect_add_anxiety"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S002"

[sub_resource type="Resource" id="Effect_add_self_doubt"]
script = ExtResource("3_effect")
effect_type = &"add_card_to_deck"
amount = 1
target = &"deck"
card_id = &"S010"

[sub_resource type="Resource" id="Effect_spend_funds"]
script = ExtResource("3_effect")
effect_type = &"gain_resource"
amount = -1
resource = &"funds"
target = &"self"

[sub_resource type="Resource" id="Effect_budget_progress"]
script = ExtResource("3_effect")
effect_type = &"gain_progress"
amount = 16
target = &"self"

[sub_resource type="Resource" id="Intent_budget_audit"]
script = ExtResource("2_intent")
id = &"budget_audit"
display_name = "经费使用审查"
intent_type = &"check"
pressure = 0
condition = &"has_2_funds"
success_effects = Array[Resource]([SubResource("Effect_spend_funds"), SubResource("Effect_budget_progress")])
failure_effects = Array[Resource]([SubResource("Effect_add_dazed")])

[sub_resource type="Resource" id="Intent_milestone_report"]
script = ExtResource("2_intent")
id = &"milestone_report"
display_name = "项目节点汇报"
intent_type = &"pressure"
pressure = 12
condition = &"has_2_draft"
failure_effects = Array[Resource]([SubResource("Effect_add_delay")])

[sub_resource type="Resource" id="Effect_spend_data"]
script = ExtResource("3_effect")
effect_type = &"gain_resource"
amount = -1
resource = &"data"
target = &"self"

[sub_resource type="Resource" id="Effect_data_progress"]
script = ExtResource("3_effect")
effect_type = &"gain_progress"
amount = 14
target = &"self"

[sub_resource type="Resource" id="Intent_data_pipeline"]
script = ExtResource("2_intent")
id = &"data_pipeline"
display_name = "数据管线验收"
intent_type = &"check"
pressure = 0
condition = &"has_2_data"
success_effects = Array[Resource]([SubResource("Effect_spend_data"), SubResource("Effect_data_progress")])
failure_effects = Array[Resource]([SubResource("Effect_add_info_overload")])

[sub_resource type="Resource" id="Effect_collab_next_down"]
script = ExtResource("3_effect")
effect_type = &"modify_next_progress"
amount = -5
target = &"self"

[sub_resource type="Resource" id="Intent_collaboration_drag"]
script = ExtResource("2_intent")
id = &"collaboration_drag"
display_name = "合作方拖拽"
intent_type = &"interference"
pressure = 8
effects = Array[Resource]([SubResource("Effect_add_anxiety"), SubResource("Effect_collab_next_down")])

[sub_resource type="Resource" id="Effect_gain_reputation"]
script = ExtResource("3_effect")
effect_type = &"gain_resource"
amount = 1
resource = &"reputation"
target = &"self"

[sub_resource type="Resource" id="Effect_paper_progress"]
script = ExtResource("3_effect")
effect_type = &"gain_progress"
amount = 12
target = &"self"

[sub_resource type="Resource" id="Intent_paper_output"]
script = ExtResource("2_intent")
id = &"paper_output"
display_name = "论文产出追问"
intent_type = &"check"
pressure = 0
condition = &"has_2_paper_fragments"
success_effects = Array[Resource]([SubResource("Effect_gain_reputation"), SubResource("Effect_paper_progress")])
failure_effects = Array[Resource]([SubResource("Effect_add_self_doubt")])

[sub_resource type="Resource" id="Effect_phase_progress"]
script = ExtResource("3_effect")
effect_type = &"gain_progress"
amount = 16
target = &"self"

[sub_resource type="Resource" id="Effect_phase_raise_target"]
script = ExtResource("3_effect")
effect_type = &"modify_target_progress"
amount = 12
target = &"self"

[resource]
script = ExtResource("1_boss")
id = &"B005"
display_name = "项目中期检查"
stage = &"doctor_2"
target_progress = 155
starting_status_cards = PackedStringArray("S004", "S005")
passive_rules = PackedStringArray("开局将 1 张信息过载和 1 张恍惚加入弃牌堆。", "进度达到 90 时进行一次项目里程碑检查。", "博二 Boss，重点检查经费、数据管线和论文产出。")
intents = Array[Resource]([SubResource("Intent_budget_audit"), SubResource("Intent_milestone_report"), SubResource("Intent_data_pipeline"), SubResource("Intent_collaboration_drag"), SubResource("Intent_paper_output")])
phase_trigger_progress = 90
phase_condition = &"has_2_funds_or_2_paper_fragments"
phase_success_effects = Array[Resource]([SubResource("Effect_phase_progress")])
phase_failure_effects = Array[Resource]([SubResource("Effect_add_delay"), SubResource("Effect_add_anxiety"), SubResource("Effect_phase_raise_target")])
phase_event_id = &"project_midterm_review"
victory_rewards = PackedStringArray("methodology_notes", "paper_fragments")
failure_result = &"project_midterm_failed"
