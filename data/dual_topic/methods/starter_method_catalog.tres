[gd_resource type="Resource" script_class="DualTopicMethodCatalog" load_steps=18 format=3]

[ext_resource type="Script" path="res://scripts/dual_topic/data/dual_topic_method_card_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/dual_topic/data/dual_topic_method_catalog.gd" id="2"]

[sub_resource type="Resource" id="Investigation1"]
script = ExtResource("1")
id = &"targeted_reading"
title = "定向阅读"
description = "识别一个未知风险；若它是低风险，额外获得 1 证据。"
category = 0
target_scope = 0
action_type = 0
effect_id = &"low_risk_insight"

[sub_resource type="Resource" id="Investigation2"]
script = ExtResource("1")
id = &"cross_source_scan"
title = "交叉检索"
description = "识别风险后继续揭示另一个未知风险，但压力 +1。"
category = 0
target_scope = 0
action_type = 0
effect_id = &"wide_scan"

[sub_resource type="Resource" id="Investigation3"]
script = ExtResource("1")
id = &"preregistration"
title = "预注册"
description = "识别风险，并降低一个已识别风险的档位。"
category = 0
target_scope = 0
action_type = 0
effect_id = &"pre_register"

[sub_resource type="Resource" id="Experiment1"]
script = ExtResource("1")
id = &"pilot_study"
title = "小样本预实验"
description = "对已识别风险进行一次 Seed 已确定的试验。"
category = 1
target_scope = 0
action_type = 1
effect_id = &"basic"

[sub_resource type="Resource" id="Experiment2"]
script = ExtResource("1")
id = &"replication"
title = "独立复现"
description = "正常结果会直接控制本次验证的风险。"
category = 1
target_scope = 0
action_type = 1
effect_id = &"replicate"

[sub_resource type="Resource" id="Experiment3"]
script = ExtResource("1")
id = &"stress_test"
